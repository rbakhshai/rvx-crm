# Postgres connection — get free Neon DB at https://neon.tech (Launch tier free for dev)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Better Auth — generate a 32-byte secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Email — Gmail SMTP (recommended for low-volume outbound)
# 1) Turn on 2-Step Verification: https://myaccount.google.com/security
# 2) Create an App Password:       https://myaccount.google.com/apppasswords
# 3) Paste the 16-char password below as GMAIL_APP_PASSWORD
# GMAIL_USER="reza@rvparkexchange.com"
# GMAIL_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"
# EMAIL_FROM_NAME="RV Park Exchange"

# Email — Resend (alternative if you don't want Gmail SMTP)
# RESEND_API_KEY=""
# EMAIL_FROM="RVX CRM <onboarding@resend.dev>"

# Postmark (later — for outbound email)
# POSTMARK_SERVER_TOKEN=""

# Twilio (later — for outbound SMS)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""

# Cloudflare R2 (later — for file uploads)
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""

# Stripe — for the /admin/revenue dashboard (admin-only).
# Get a RESTRICTED key with read-only access to Charges + Customers:
# https://dashboard.stripe.com/apikeys → Create restricted key.
# (A regular sk_live/sk_test secret key works too but is overkill — we only read.)
# STRIPE_SECRET_KEY="rk_live_..."

# Google Maps Embed — for the interactive map on deal pages and triage cockpit.
# 1) Create / pick a project: https://console.cloud.google.com/google/maps-apis/
# 2) Enable "Maps Embed API"
# 3) Create an API key. RESTRICT it by HTTP referrer to your domains
#    (e.g. http://localhost:3000/*, https://your-prod-domain.com/*).
# Without this, the map area shows a graceful "Open in Google Maps ↗" fallback.
# GOOGLE_MAPS_API_KEY=""

# Anthropic (later — for AI features)
# ANTHROPIC_API_KEY=""

# Postgres connection — get free Neon DB at https://neon.tech (Launch tier free for dev)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Better Auth — generate a 32-byte secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Email — Resend (free tier, used for UW "Ready for review" notifications)
# Sign up at https://resend.com → create API key → paste below → restart dev
# RESEND_API_KEY=""
# EMAIL_FROM="RVX CRM <onboarding@resend.dev>"

# Postmark (later — for outbound email)
# POSTMARK_SERVER_TOKEN=""

# Twilio (later — for outbound SMS)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""

# Cloudflare R2 (later — for file uploads)
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""

# Anthropic (later — for AI features)
# ANTHROPIC_API_KEY=""
